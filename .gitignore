# сборка
build/
*.obj
*.pdb
*.ilk
*.exe
# исходники OCCT клонируются отдельно, в репозиторий не кладутся
occt/
# результаты прогонов
*.log
*.brep
*.step
# кэш Python
__pycache__/
*.pyc
# временные выгрузки GitHub API
.c_*.json
.hist_*.json
# установленный SDK патченого ядра: артефакт сборки, пересоздаётся build-scripts, в git не кладётся
install/
# вывод пробы ядра, пишется скриптом при каждом запуске
issues/001-occt-fillet-at-seam/build-scripts/verify-seam-fillet.txt
# результаты скриптов разбора фикстур, пересоздаются при запуске
issues/*/fixtures/*.txt
